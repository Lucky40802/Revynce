{
  "rules": {
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "classes": {
      ".read": "auth !== null",
      ".write": "auth !== null"
    },
    "classMembers": {
      ".read": "auth !== null",
